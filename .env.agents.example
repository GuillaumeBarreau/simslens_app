# ==============================================================================
# Système d'agents — copier en `.env.agents` (non versionné) et remplir.
# ==============================================================================
# Fichier séparé de `.env` / `.env.local` exprès : ceux-ci sont recopiés vers les
# 4 workspaces par scripts/env-manager.js, ce qui exposerait le webhook à l'app.

# Webhook entrant du salon Discord des agents (serveur personnel du mainteneur,
# distinct du serveur des joueurs). Paramètres du salon > Intégrations > Webhooks.
AGENTS_DISCORD_WEBHOOK_URL=

# Chemin de la CLI Claude Code, si `claude` n'est pas dans le PATH
# (ex. %APPDATA%\npm\claude.cmd sous Windows, ~/.local/bin/claude ailleurs).
# Laisser vide sinon.
CLAUDE_BIN=

# Kill switch : `false` coupe immédiatement tout le système d'agents.
# Alternative : créer le fichier .claude/agents.disabled
AGENTS_ENABLED=true
