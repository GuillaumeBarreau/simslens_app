# ==============================================================================
# Template d'environnement PRODUCTION
# ==============================================================================
# 1. Copier ce fichier en `.env` sur le serveur de production
# 2. Remplacer toutes les valeurs placeholder par les vraies credentials
# 3. Générer un SESSION_SECRET fort : openssl rand -base64 32
# 4. Ne jamais commiter un .env contenant de vraies credentials
#
# NOTE : DATABASE_URL, REDIS_HOST et REDIS_PORT ne sont PAS lus depuis ce
# fichier en production — docker-compose.yml les fixe sur le réseau Docker
# interne (postgres:5432 / redis:6379). Ils ne figurent donc pas ci-dessous.
# ==============================================================================

NODE_ENV=production

# ------------------------------------------------------------------------------
# APP — client public (app/) — injecté au build de l'image
# ------------------------------------------------------------------------------
VITE_API_BASE_URL=https://your-domain.com
# Extensions valides : The-War-Within | Midnight
VITE_WOW_EXTENSION=Midnight
# Saisons valides : The-War-Within -> season-03 | Midnight -> season-01
VITE_CURRENT_SEASON=season-01
# DSN Sentry du front (Sentry > Project Settings > Client Keys). Vide : Sentry désactivé.
VITE_SENTRY_DSN=
# client_id de l'application Discord du bot (Developer Portal > OAuth2).
# Vide : lien d'invitation du bot masqué dans Réglages > Discord.
VITE_DISCORD_CLIENT_ID=

# ------------------------------------------------------------------------------
# APP_DASHBOARD — back-office (app_dashboard/) — injecté au build de l'image
# ------------------------------------------------------------------------------
VITE_CLERK_PUBLISHABLE_KEY=pk_live_xxx_from_clerk_dashboard
# VITE_BASE_URL est forcé à /dashboard/ par docker-compose.yml

# ------------------------------------------------------------------------------
# SERVER — API (server/)
# ------------------------------------------------------------------------------
PORT=5000
CLIENT_URL=https://your-domain.com
SERVER_API_URL=https://your-domain.com
SESSION_SECRET=CHANGE_THIS_TO_A_SECURE_RANDOM_STRING_IN_PRODUCTION
LOG_LEVEL=info

# Blizzard API
BNET_ID=your_production_bnet_id
BNET_SECRET=your_production_bnet_secret

# Clerk
CLERK_PUBLISHABLE_KEY=pk_live_xxx_from_clerk_dashboard

# ------------------------------------------------------------------------------
# DISCORD
# ------------------------------------------------------------------------------
ENABLE_DISCORD_BOT=true
DISCORD_BOT_TOKEN=your_discord_bot_token
# Réseau interne Docker
DISCORD_SERVER_URL=http://discord:5001
DISCORD_CLIENT_ID=your_discord_client_id
DISCORD_CLIENT_SECRET=your_discord_client_secret
DISCORD_CHANNEL_ID=
DISCORD_ANNOUNCE_CHANNEL_ID=
DISCORD_RAID_CATEGORY_ID=

# ------------------------------------------------------------------------------
# OPTIONNEL
# ------------------------------------------------------------------------------
# Le seed au démarrage est forcé à 0 par docker-compose.yml en production.
# Initialisation des données à faire manuellement.
# INIT_DATA_ON_START=0
# REPORT_QUEUE_CONCURRENCY=3
# INCLUDE_STACK_IN_RESPONSES=false
