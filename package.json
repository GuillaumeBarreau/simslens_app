{
  "name": "simslens-monorepo",
  "version": "1.0.0",
  "private": true,
  "license": "MIT",
  "workspaces": [
    "app",
    "app_dashboard",
    "server",
    "server_discord"
  ],
  "scripts": {
    "dev": "npm run sync:permissions && npx concurrently \"npm run dev:app\" \"npm run dev:dashboard\" \"npm run dev:server\" \"npm run dev:discord\"",
    "dev:dashboard": "cd app_dashboard && npm run dev",
    "build:dashboard": "cd app_dashboard && npm run build",
    "sync:permissions": "node scripts/sync-permissions.js",
    "docs:api": "node scripts/gen-api-docs.mjs",
    "docs:db": "node scripts/gen-db-docs.js",
    "docs": "npm run docs:api && npm run docs:db",
    "dev:server": "cd server && npm run dev",
    "dev:app": "cd app && npm run dev",
    "dev:discord": "cd server_discord && npm run start",
    "build:app": "cd app && npm run build",
    "build:server": "cd server && npm run build",
    "start:server": "cd server && npm run start",
    "start:server:prod": "cd server && npm run start:prod",
    "start:server:migrate": "cd server && npm run start:migrate",
    "install:server": "cd server && npm install",
    "install:app": "cd app && npm install",
    "install:discord": "cd server_discord && npm install",
    "lint": "eslint . --ext .js,.ts,.tsx --max-warnings=0 --ignore-path .eslintignore",
    "lint:fix": "eslint . --ext .js,.ts,.tsx --fix --ignore-path .eslintignore",
    "format:fix": "prettier --write .",
    "format": "prettier --check .",
    "docker:up": "docker compose --env-file .env up -d --build --remove-orphans",
    "docker:down": "docker compose --env-file .env down",
    "docker:down:rm": "docker compose --env-file .env down --remove-orphans",
    "docker:clean": "bash ./deployment/deploy.sh cleanup",
    "docker:stats": "bash ./deployment/deploy.sh status",
    "deploy": "bash ./deployment/deploy.sh production",
    "deploy:front": "bash ./deployment/deploy.sh production front",
    "deploy:back": "bash ./deployment/deploy.sh production back",
    "deploy:discord": "bash ./deployment/deploy.sh production discord",
    "deploy:dashboard": "bash ./deployment/deploy.sh production dashboard",
    "env:init": "node scripts/env-manager.js .env",
    "env:local": "node scripts/env-manager.js .env.local",
    "prisma:studio": "cd server && npx prisma studio",
    "prisma:generate": "cd server && npx prisma generate",
    "prisma:migrate": "cd server && npx prisma migrate dev",
    "prisma:migrate:deploy": "cd server && npx prisma migrate deploy",
    "prisma:migrate:reset": "cd server && npx prisma migrate reset",
    "prisma:seed": "cd server && npx prisma db seed",
    "prisma:format": "cd server && npx prisma format",
    "prisma:push": "cd server && npx prisma db push",
    "prisma:pull": "cd server && npx prisma db pull",
    "server:init-data": "cd server && npm run init-data",
    "server:init-fake-data": "cd server && npm run init-fake-data",
    "db:reset": "npm run prisma:migrate:reset -- --force && npm run prisma:generate && npm run server:init-data",
    "deadcode": "knip --workspace app",
    "verify": "node scripts/agents/verify.mjs",
    "agents:tickets": "node scripts/agents/tickets.mjs",
    "agents:verify": "node scripts/agents/verify.mjs",
    "agents:test": "node --test scripts/agents/tests/*.test.mjs",
    "agents:cycle": "node scripts/agents/run-cycle.mjs",
    "agents:watch": "node scripts/agents/watch.mjs",
    "agents:develop": "node scripts/agents/run-develop.mjs"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.72.1",
    "@typescript-eslint/parser": "^8.72.1",
    "concurrently": "^10.0.6",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.7",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "eslint-plugin-tailwindcss": "^4.4.0",
    "knip": "^6.43.0",
    "prettier": "^3.9.10"
  }
}
