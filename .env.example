# ==============================================================================
# Fichier d'exemple — copier en `.env.local` puis lancer `npm run env:local`
# ==============================================================================
# `npm run env:local` lit ce .env.local racine et génère les .env de chaque workspace
# (app/, app_dashboard/, server/, server_discord/) via scripts/env-manager.js.
# Ne jamais éditer les .env des workspaces à la main : ils sont écrasés.
#
# Valeurs ci-dessous = configuration DEV LOCAL (services docker exposés sur
# l'hôte). Pour la production, voir .env.production.template.
# ==============================================================================

NODE_ENV=development

# ------------------------------------------------------------------------------
# APP — client public (app/) — Vite, injecté au build
# ------------------------------------------------------------------------------
VITE_API_BASE_URL=http://localhost:5000
# Extensions valides : The-War-Within | Midnight  (app/src/config/seasonConfig.ts)
VITE_WOW_EXTENSION=Midnight
# Saisons valides : The-War-Within -> season-03 | Midnight -> season-01
VITE_CURRENT_SEASON=season-01
# DSN Sentry du front (optionnel). Vide : Sentry désactivé (aucun envoi).
VITE_SENTRY_DSN=
# client_id de l'application Discord du bot, pour le lien d'invitation des
# Réglages > Discord (optionnel). Vide : lien d'invitation masqué.
VITE_DISCORD_CLIENT_ID=

# ------------------------------------------------------------------------------
# APP_DASHBOARD — back-office (app_dashboard/) — Vite, injecté au build
# ------------------------------------------------------------------------------
VITE_CLERK_PUBLISHABLE_KEY=pk_test_xxx_from_clerk_dashboard
# Sous-chemin de déploiement du dashboard. Laisser `/` en local.
# En docker le Dockerfile force /dashboard/.
VITE_BASE_URL=/

# ------------------------------------------------------------------------------
# SERVER — API (server/)
# ------------------------------------------------------------------------------
PORT=5000
CLIENT_URL=http://localhost:5173
SERVER_API_URL=http://localhost:5000
# Générer avec : openssl rand -base64 32
SESSION_SECRET=change_me_to_something_secure_random
# error | warn | info | debug
LOG_LEVEL=info

# Base de données — localhost car c'est votre machine qui contacte le conteneur
# postgres. Port 5433 : c'est le port publié sur l'hôte par les deux compose.
# Identifiants `postgres` / `postgres` : ceux de docker-compose.local.yml.
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/droptimizer?schema=public"

# Redis (BullMQ) — 6380 = port publié par docker-compose.yml
REDIS_HOST=localhost
REDIS_PORT=6380

# Blizzard API — credentials sur https://develop.battle.net/
BNET_ID=votre_bnet_id
BNET_SECRET=votre_bnet_secret

# Clerk (vérification des sessions côté serveur)
CLERK_PUBLISHABLE_KEY=pk_test_xxx_from_clerk_dashboard

# ------------------------------------------------------------------------------
# DISCORD — partagé server/ et server_discord/
# ------------------------------------------------------------------------------
ENABLE_DISCORD_BOT=false
DISCORD_BOT_TOKEN=
# URL du micro-service bot, appelée par le server. Docker : http://discord:5001
DISCORD_SERVER_URL=http://localhost:5001
# OAuth "Login with Discord"
DISCORD_CLIENT_ID=votre_discord_client_id
DISCORD_CLIENT_SECRET=votre_discord_client_secret
# Salon par défaut pour les annonces de boss kill / rapports (optionnel)
DISCORD_CHANNEL_ID=
# Salon dédié aux annonces d'événements — fallback sur DISCORD_CHANNEL_ID (optionnel)
DISCORD_ANNOUNCE_CHANNEL_ID=
# Catégorie sous laquelle créer les salons de raid (optionnel)
DISCORD_RAID_CATEGORY_ID=
# URL utilisée par server_discord pour rappeler l'API, prioritaire sur
# SERVER_API_URL. Utile en docker uniquement (http://server:5000).
# INTERNAL_SERVER_URL=

# ------------------------------------------------------------------------------
# OPTIONNEL — surcharges de comportement (valeurs par défaut si absentes)
# ------------------------------------------------------------------------------
# Seed la base au démarrage du conteneur server (docker-entrypoint.sh). Défaut : 0
INIT_DATA_ON_START=1
# Nombre de jobs de rapport traités en parallèle. Défaut : 3
# REPORT_QUEUE_CONCURRENCY=3
# Mettre à "false" pour utiliser le vrai handler Discord au lieu du mock.
# ATTENTION : le mock est ACTIF par défaut tant que cette variable ne vaut pas "false".
# ENABLE_DISCORD_MOCK=false
# Renvoie la stack trace dans les réponses d'erreur en production. Défaut : false
# INCLUDE_STACK_IN_RESPONSES=false
# Connexion de développement sans Battle.net : GET /auth/dev-login?userId=<id>.
# Mettre à 1 en LOCAL uniquement (tests, captures d'écran des agents). Ignorée hors
# NODE_ENV=development, si CLIENT_URL n'est pas localhost ou si la requête ne vient
# pas de la machine. Ne JAMAIS la définir en production. Défaut : désactivée.
# ENABLE_DEV_LOGIN=1
