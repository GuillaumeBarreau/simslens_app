{
  "name": "simslens-server",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "scripts": {
    "dev": "tsx watch ./src/www",
    "start": "node ./src/www",
    "build": "tsc --project tsconfig.json",
    "start:prod": "node ./dist/www",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src --ext .js,.ts --max-warnings=0",
    "lint:fix": "eslint src --ext .js,.ts --fix",
    "start:migrate": "MIGRATE_ITEMS_ON_START=1 node ./src/www",
    "start:migrate:win": "set MIGRATE_ITEMS_ON_START=1 && node ./src/www",
    "init-data": "node ./src/scripts/initData.js",
    "init-fake-data": "node src/scripts/seedFakeData/initFakeData.js",
    "add-items": "node ./src/scripts/updateItems.js",
    "add-classes": "node ./src/scripts/updateClasses.js",
    "add-characters": "node ./src/scripts/updateCharacters.js",
    "update-equippable-items": "node ./src/scripts/data/update-equippable-items.js",
    "update-equippable-items:check": "node ./src/scripts/data/update-equippable-items.js --dry-run"
  },
  "dependencies": {
    "@blizzard-api/client": "^2.2.2",
    "@clerk/backend": "^3.26.4",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "@prisma/config": "^7.10.1",
    "@types/express": "^5.0.3",
    "axios": "^1.21.0",
    "blizzard.js": "^4.6.0",
    "bullmq": "^5.78.1",
    "connect-redis": "^6.1.3",
    "cookie-parser": "^1.4.5",
    "debug": "^4.1.1",
    "discord.js": "^14.25.0",
    "dotenv": "^16.6.1",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "express-session": "^1.18.2",
    "happy-dom": "^21.0.4",
    "helmet": "^8.1.0",
    "http-errors": "^2.0.0",
    "ioredis": "^5.8.2",
    "joi": "^18.3.1",
    "jose": "^6.2.13",
    "morgan": "^1.12.1",
    "node-cron": "^3.0.3",
    "node-schedule": "^2.1.2",
    "nodemailer": "^10.2.1",
    "passport": "^0.7.0",
    "passport-bnet": "^2.0.0",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "pino-pretty": "^13.2.0",
    "prisma": "^7.10.1",
    "request": "^2.88.2",
    "tinyqueue": "^2.0.3",
    "vite": "7.3.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/morgan": "^1.9.10",
    "@types/node": "^24.10.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "uuid": "^13.0.0",
    "vitest": "^4.0.10",
    "zod-prisma-types": "^3.3.10"
  },
  "prisma": {
    "seed": "node ./src/scripts/initData.js"
  }
}
