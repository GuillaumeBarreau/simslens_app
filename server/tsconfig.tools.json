{
  // Fichiers de configuration à la racine de server/ (prisma, vitest).
  // Ils sont chargés en ESM par leurs outils respectifs, pas par Node en
  // CommonJS : d'où module/moduleResolution différents du projet principal.
  // composite interdit noEmit, donc on n'émet que des .d.ts jetables.
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "types": ["node"],
    "composite": true,
    "emitDeclarationOnly": true,
    "outDir": "node_modules/.tmp/tools-types",
    "tsBuildInfoFile": "node_modules/.tmp/tsconfig.tools.tsbuildinfo"
  },
  "include": ["prisma.config.ts", "vitest.config.ts"]
}
